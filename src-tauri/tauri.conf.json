{
	"$schema": "https://schema.tauri.app/config/2",
	"productName": "Limestone",
	"version": "../package.json",
	"identifier": "app.limestone",
	"build": {
		"beforeDevCommand": "npm run dev",
		"devUrl": "http://localhost:1420",
		"beforeBuildCommand": "npm run build",
		"frontendDist": "../build"
	},
	"app": {
		"windows": [
			{
				"label": "main",
				"title": "Limestone",
				"width": 800,
				"height": 600,
				"minWidth": 420,
				"minHeight": 256,
				"decorations": false
			}
		],
		"security": {
			"csp": null,
			"assetProtocol": {
				"enable": true,
				"scope": []
			}
		}
	},
	"bundle": {
		"active": true,
		"createUpdaterArtifacts": true,
		"targets": "all",
		"publisher": "Voithos Labs",
		"copyright": "© 2026 Voithos Labs",
		"homepage": "https://limestone.app",
		"icon": [
			"icons/32x32.png",
			"icons/128x128.png",
			"icons/128x128@2x.png",
			"icons/icon.icns",
			"icons/icon.ico"
		],
		"windows": {
			"nsis": {
				"headerImage": "installer/header.bmp",
				"sidebarImage": "installer/sidebar.bmp",
				"installerIcon": "icons/icon.ico",
				"installMode": "currentUser"
			}
		}
	},
	"plugins": {
		"updater": {
			"pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDEzQzZENzRBODMyNjI3OTUKUldTVkp5YURTdGZHRTBNaE1oOW1XdGIrVGE3Y1o2dGNLcVZTb2RiWldPRURZYnpienV2dDd1Ui8K",
			"endpoints": [
				"https://github.com/voithos-labs/limestone/releases/latest/download/latest.json"
			],
			"windows": {
				"installMode": "passive"
			}
		}
	}
}

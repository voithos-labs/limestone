{
  "documents": {
    "use_yaml_frontmatter": true,
    "add_yaml_frontmatter_to_existing_documents": false
  },
  "indexing": {
    "frontmatter_read_buffer_size": 512
  },
  "search": {
    "max_results": 15,
    "prefix_candidate_pool": 50,
    "fuzzy_threshold": 2,
    "recency_weight": 0.5,
    "recency_multiplier": 100.0,
    "recency_default_days": 365.0
  }
}

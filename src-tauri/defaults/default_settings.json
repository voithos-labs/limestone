{
	"version": 1,
	"appearance": {
		"mode": "system",
		"accent": "default",
		"window_style": "auto",
		"mica": false,
		"compact_tabs": true,
		"compact_doc_header": false,
		"collapse_pinned_tabs": true,
		"ui_scale_percent": 100,
		"max_page_width": 1000,
		"max_view_width": 1000
	},
	"editor": {
		"mode": "live",
		"font": "Inter, system-ui, sans-serif",
		"font_size": 14
	},
	"indexing": {
		"frontmatter_read_buffer_size": 1024
	},
	"sources": {
		"git_frontmatter_off": true,
		"deleted_retention_days": 30
	},
	"updates": {
		"auto_install": false
	},
	"general": {
		"action_hints": true,
		"folders": "show"
	},
	"todo": {
		"statuses": [
			{ "value": "todo", "color": 0, "done": false },
			{ "value": "doing", "color": 4, "done": false },
			{ "value": "done", "color": 12, "done": true }
		]
	},
	"shortcuts": {}
}

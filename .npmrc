# Install `file:` dependencies as real folders rather than symlinks. The editor
# library (aragonite) is consumed from a sibling checkout; symlinked, its own
# node_modules stays on the resolution path and a second copy of Svelte lands in
# the type program, so `Snippet` from one copy stops matching `Snippet` from the
# other. Installing a copy is also what a published dependency looks like.
#
# Cost: after changing aragonite, re-run `npm install ../aragonite` here to pick
# the new build up.
install-links=true

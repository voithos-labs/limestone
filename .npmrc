# Install `file:` dependencies as real folders rather than symlinks. The editor
# library (aragonite) is consumed from a sibling checkout; symlinked, its own
# node_modules stays on the resolution path and a second copy of Svelte lands in
# the type program, so `Snippet` from one copy stops matching `Snippet` from the
# other. Installing a copy is also what a published dependency looks like.
#
# Cost: the copy is not refreshed by any form of `npm install` while the version
# string is unchanged — not `npm install ../aragonite`, not even with `--force`.
# Deleting it first is what works, which is all `npm run editor:sync` does. After
# rebuilding aragonite, run that, or keep consuming a stale dist. Restart any dev
# server afterwards — Vite does not watch node_modules, and Playwright reuses a
# running server outside CI.
install-links=true

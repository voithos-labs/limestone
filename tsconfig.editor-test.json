{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "skipLibCheck": true,
    "rootDir": ".",
    "outDir": ".tmp/editor-test",
    "noEmitOnError": true,
    "declaration": false,
    "sourceMap": false,
